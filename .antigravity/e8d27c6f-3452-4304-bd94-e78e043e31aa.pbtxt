    replacement_infos {
      original_chunk {
        target_content: "  <!-- \343\203\230\343\203\203\343\203\200\343\203\274\343\202\250\343\203\252\343\202\242 -->\n  <header class=\"w-full max-w-4xl text-center mb-10 mt-4 px-4\">\n    <div class=\"bg-white px-8 py-10 rounded-3xl shadow-[0_16px_32px_rgba(65,176,125,0.08)] border-2 border-brand-primary/10 relative overflow-hidden group\">\n      <!-- \350\243\205\351\243\276\347\232\204\343\201\252\350\203\214\346\231\257\343\202\260\343\203\251\343\203\207\343\203\274\343\202\267\343\203\247\343\203\263 -->\n      <div class=\"absolute top-0 left-0 w-full h-2 bg-gradient-to-r from-brand-primary via-accent-question to-accent-answer\"></div>\n      \n      <span class=\"inline-block bg-brand-secondary text-brand-secondary-text text-sm font-bold px-5 py-2 rounded-full mb-5 shadow-sm\">\n        \343\201\223\343\201\217\343\201\224\343\200\214\343\201\244\343\201\274\343\201\277\343\200\215\343\201\256 \343\201\214\343\201\217\343\201\227\343\202\205\343\201\206\n      </span>\n      <h1 id=\"page-title\" class=\"text-3xl md:text-4xl text-gray-800 mb-6 font-bold tracking-tight ruby-rt-small\">\n        \343\201\204\343\202\215\343\201\204\343\202\215\343\201\252 \343\201\244\343\201\274\343\201\277\343\201\250 <ruby>\350\212\261<rt>\343\201\257\343\201\252</rt></ruby>\n      </h1>\n      <p class=\"text-base md:text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto ruby-rt-small\">\n        \343\201\244\343\201\274\343\201\277\343\201\256 <ruby>\347\224\273\345\203\217<rt>\343\201\214\343\201\236\343\201\206</rt></ruby>\343\202\222 \343\201\212\343\201\231\343\201\250\343\200\201\343\201\251\343\202\223\343\201\252 <ruby>\350\212\261<rt>\343\201\257\343\201\252</rt></ruby>\343\201\214 <ruby>\345\222\262<rt>\343\201\225</rt></ruby>\343\201\217\343\201\213 \343\202\217\343\201\213\343\202\213\343\202\210\357\274\201<br>\n        \343\200\214\343\201\223\343\201\210\343\201\247 \343\201\215\343\201\217\343\200\215\343\203\234\343\202\277\343\203\263\343\202\222 \3
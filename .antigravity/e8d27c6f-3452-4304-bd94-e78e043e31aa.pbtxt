        }
        lines {
          text: "      "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      osc.connect(gain);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {

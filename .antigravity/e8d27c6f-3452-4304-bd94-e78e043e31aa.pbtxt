    replacement_infos {
      original_chunk {
        target_content: "  // 2. \343\202\253\343\203\274\343\203\211HTML\343\201\256\345\213\225\347\232\204\347\224\237\346\210\220\n  function createCardHTML(plant) {\n    return `\n      <article class=\"card-wrapper\" id=\"card-${plant.id}\" data-category=\"${plant.category}\">\n        <div class=\"card-outer\">\n          <div class=\"card-inner\">\n            <!-- \343\201\244\343\201\274\343\201\277\357\274\210\350\241\250\357\274\211 -->\n            <div class=\"card-face card-front\">\n              <div class=\"card-badge badge-question\">\343\201\250\343\201\204</div>\n              <div class=\"image-box\">\n                <img src=\"${plant.budImage}\" alt=\"${plant.name}\343\201\256\343\201\244\343\201\274\343\201\277\"\n                     width=\"1024\" height=\"1024\" loading=\"lazy\" decoding=\"async\">\n              </div>\n              <div class=\"text-box\">\n                <p class=\"question-text js-read-target\">\n                  ${plant.question}\n                </p>\n              </div>\n              <div class=\"btn-group\">\n                <button class=\"btn btn-audio btn-front-audio\" aria-label=\"\343\201\223\343\201\210\343\201\247 \343\201\215\343\201\217\">\n                  <span class=\"btn-icon\">\360\237\224\212</span>\343\201\223\343\201\210\343\201\247 \343\201\215\343\201\217\n                </button>\n                <button class=\"btn btn-action btn-flip\" aria-label=\"\343\201\223\343\201\237\343\201\210\343\202\222 \343\201\277\343\202\213\">\n                  \343\201\223\343\201\237\343\201\210\343\202\222 \343\201\277\343\202\213 <span class=\"btn-arrow\">\342\206\222</span>\n                </button>\n              </div>\n            </div>\n            <!-- \350\212\261\357\274\210\350\243\217\357\274\211 -->\n            <div class=\"card-face card-back\">\n              <div class=\"card-badge badge-answer\">\343\201\223\343\201\237\343\201\210</div>\n              <div class=\"image-box\">\n                <img src=\"${plant.flowerImage}\" alt=\"\345\222\262\343\201\204\343\201\237${plant.name}\343\201\256\350\212\261\"\n                     width=\"1024\" height=\"1024\" loading=\"lazy\" decoding=\"async\">\n              </div>\n              <div class=\"text-box\">\n                <p class=\"answer-text js-read-target\">\n                  ${plant.answer}\n                </p>\n              </div>\n              <div class=\"btn-group\">\n                <button class=\"btn btn-audio btn-back-audio\" aria-label=\"\343\201\223\343\201\210\343\201\247 \343\201\215\343\201\217\">\n                  <span class=\"btn-icon\">\360\237\224\212</span>\343\201\223\343\201\210\343\201\247 \343\201\215\343\201\217\n                </button>\n                <button class=\"btn btn-action btn-secondary btn-flip\" aria-label=\"\343\201\244\343\201\274\343\201\277\343\201\253 \343\202\202\343\201\251\343\201\231\">\n                  <span class=\"btn-arrow\">\342\206\220</span> \343\201\244\343\201\274\343\201\277\343\202\222 \343\201\277\343\202\213\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </article>\n    `;\n  }"
        replacement_content: "  // 2. \343\202\253\343\203\274\343\203\211HTML\343\201\256\345\213\225\347\232\204\347\224\237\346\210\220\n  function createCardHTML(plant) {\n    return `\n      <article class=\"card-wrapper perspective-1500 w-full max-w-sm animate-card-fade-in group cursor-pointer\" id=\"card-${plant.id}\" data-category=\"${plant.category}\">\n        <div class=\"card-outer w-full h-[620px]\">\n          <div class=\"card-inner relative w-full h-full preserve-3d transition-transform duration-700 ease-[cubic-bezier(0.175,0.885,0.32,1.275)] shadow-sm group-hover:shadow-xl group-hover:-translate-y-2 rounded-3xl\">\n            <!-- \343\201\244\343\201\274\343\201\277\357\274\210\350\241\250\357\274\211 -->\n            <div class=\"card-face card-front absolute w-full h-full backface-hidden rounded-3xl bg-white border border-brand-primary/10 p-6 flex flex-col justify-between overflow-hidden\">\n              <div class=\"absolute top-4 left-4 text-sm font-bold text-white bg-accent-question px-4 py-1.5 rounded-full shadow-md z-10\">\343\201\250\343\201\204</div>\n              <div class=\"w-full h-[260px] rounded-2xl overflow-hidden relative bg-gray-50/50 mb-4\">\n                <img src=\"${plant.budImage}\" alt=\"${plant.name}\343\201\256\343\201\244\343\201\274\343\201\277\"\n                     width=\"1024\" height=\"1024\" loading=\"lazy\" decoding=\"async\" class=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\">\n              </div>\n              <div class=\"flex-1 flex items-center justify-center p-2 text-left mb-4\">\n                <p class=\"text-xl text-gray-800 font-medium leading-relaxed ruby-rt-small js-read-target w-full\">\n                  ${plant.question}\n                </p>\n              </div>\n              <div class=\"flex gap-3 mt-auto\">\n                <button class=\"btn-audio btn-front-audio flex-1 bg-gray-50 hover:bg-gray-100 text-gray-600 hover:text-gray-900 border border-gray-200/50 rounded-xl py-3 px-4 font-bold transition-colors flex items-center justify-center gap-2\" aria-label=\"\343\201\223\343\201\210\343\201\247 \343\201\215\343\201\217\">\n                  <span class=\"text-lg\">\360\237\224\212</span>\343\201\223\343\201\210\343\201\247 \343\201\215\343\201\217\n                </button>\n                <button class=\"btn-flip flex-1 bg-brand-primary hover:bg-brand-hover text-white rounded-xl py-3 px-4 font-bold shadow-md hover:shadow-lg transition-all hover:-translate-y-0.5 flex items-center justify-center group/btn\" aria-label=\"\343\201\223\343\201\237\343\201\210\343\202\222 \343\201\277\343\202\213\">\n                  \343\201\223\343\201\237\343\201\210\343\202\222 \343\201\277\343\202\213 <span class=\"ml-1 transition-transform group-hover/btn:translate-x-1\">\342\206\222</span>\n                </button>\n              </div>\n            </div>\n            <!-- \350\212\261\357\274\210\350\243\217\357\274\211 -->\n            <div class=\"card-face card-back absolute w-full h-full backface-hidden rotate-y-180 rounded-3xl bg-white border border-accent-answer/20 p-6 flex flex-col justify-between overflow-hidden\">\n              <div class=\"absolute top-4 left-4 text-sm font-bold text-white bg-accent-answer px-4 py-1.5 rounded-full shadow-md z-10\">\343\201\223\343\201\237\343\201\210</div>\n              <div class=\"w-full h-[260px] rounded-2xl overflow-hidden relative bg-gray-50/50 mb-4\">\n                <img src=\"${plant.flowerImage}\" alt=\"\345\222\262\343\201\204\343\201\237${plant.name}\343\201\256\350\212\261\"\n                     width=\"1024\" height=\"1024\" loading=\"lazy\" decoding=\"async\" class=\"w-full h-full object-cover\">\n              </div>\n              <div class=\"flex-1 flex items-center justify-center p-2 text-left mb-4\">\n                <p class=\"text-xl text-gray-800 font-medium leading-relaxed ruby-rt-small js-read-target w-full\">\n                  ${plant.answer}\n                </p>\n              </div>\n              <div class=\"flex gap-3 mt-auto\">\n                <button class=\"btn-audio btn-back-audio flex-1 bg-gray-50 hover:bg-gray-100 text-gray-600 hover:text-gray-900 border border-gray-200/50 rounded-xl py-3 px-4 font-bold transition-colors flex items-center justify-center gap-2\" aria-label=\"\343\201\223\343\201\210\343\201\247 \343\201\215\343\201\217\">\n                  <span class=\"text-lg\">\360\237\224\212</span>\343\201\223\343\201\210\343\201\247 \343\201\215\343\201\217\n                </button>\n                <button class=\"btn-flip flex-1 bg-brand-secondary hover:bg-brand-secondary/80 text-brand-secondary-text rounded-xl py-3 px-4 font-bold transition-all hover:-translate-y-0.5 flex items-center justify-center group/btn\" aria-label=\"\343\201\244\343\201\274\343\201\277\343\201\253 \343\202\202\343\201\251\343\201\231\">\n                  <span class=\"mr-1 transition-transform group-hover/btn:-translate-x-1\">\342\206\220</span> \343\201\244\343\201\274\343\201\277\343\202\222 \343\201\277\343\202\213\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </article>\n    `;\n  }"

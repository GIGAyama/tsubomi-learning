  planner_response {
    response: "\343\201\212\344\275\277\343\201\204\343\201\256GitHub Pages\343\201\247CSS\357\274\210Tailwind\357\274\211\343\201\214\351\201\251\347\224\250\343\201\225\343\202\214\343\201\232404\343\202\250\343\203\251\343\203\274\343\201\253\343\201\252\343\201\243\343\201\246\343\201\227\343\201\276\343\201\243\343\201\237\343\201\256\343\201\257\343\200\201\344\273\212\345\233\236\343\201\256\343\202\242\343\203\203\343\203\227\343\203\207\343\203\274\343\203\210\343\201\247**\343\200\214Vite\357\274\210\343\203\223\343\203\253\343\203\211\343\203\204\343\203\274\343\203\253\357\274\211\343\200\215\343\202\222\344\275\277\343\201\243\343\201\237\346\247\213\346\210\220\343\201\253\345\244\211\346\233\264\343\201\227\343\201\237\343\201\237\343\202\201**\343\201\247\343\201\231\343\200\202\n\n\344\273\245\345\211\215\343\201\257\343\201\237\343\201\240\343\201\256HTML/CSS\343\203\225\343\202\241\343\202\244\343\203\253\343\201\247\343\201\227\343\201\237\343\201\214\343\200\201\346\234\200\346\226\260\343\201\256Tailwind CSS\343\202\222\345\213\225\344\275\234\343\201\225\343\201\233\343\202\213\343\201\237\343\202\201\343\201\253\343\201\257\343\200\201\343\202\263\343\203\274\343\203\211\343\202\222\345\244\211\346\217\233\357\274\210\343\203\223\343\203\253\343\203\211\357\274\211\343\201\231\343\202\213\345\207\246\347\220\206\343\201\214\345\277\205\350\246\201\343\201\253\343\201\252\343\202\212\343\201\276\343\201\231\343\200\202GitHub\343\201\253\345\244\211\346\233\264\343\202\222\347\233\264\346\216\245\343\203\227\343\203\203\343\202\267\343\203\245\343\201\231\343\202\213\343\201\250\343\200\201\345\244\211\346\217\233\345\211\215\343\201\256\343\202\275\343\203\274\343\202\271\343\202\263\343\203\274\343\203\211\343\201\214\343\201\235\343\201\256\343\201\276\343\201\276\345\205\254\351\226\213\343\201\225\343\202\214\343\201\246\343\201\227\343\201\276\343\201\204\343\200\201\343\203\226\343\203\251\343\202\246\343\202\266\343\201\214`tailwindcss`
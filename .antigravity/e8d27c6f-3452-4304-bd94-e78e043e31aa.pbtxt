    instruction: "Import Tailwind CSS and reset custom styles"
    replacement_infos {
      original_chunk {
        target_content: "/* ==========================================================================\n   \343\201\244\343\201\274\343\201\277\345\255\246\347\277\222\346\224\257\346\217\264\343\202\265\343\202\244\343\203\210 \343\203\207\343\202\266\343\202\244\343\203\263\343\202\267\343\202\271\343\203\206\343\203\240 & \343\202\271\343\202\277\343\202\244\343\203\253\n   ========================================================================== */\n\n/* \345\244\211\346\225\260\345\256\232\347\276\251\357\274\210\347\233\256\343\201\253\345\204\252\343\201\227\343\201\217\343\200\201\343\203\227\343\203\254\343\203\237\343\202\242\343\203\240\346\204\237\343\201\256\343\201\202\343\202\213\343\202\253\343\203\251\343\203\274\343\203\221\343\203\254\343\203\203\343\203\210\357\274\211 */\n:root {\n  --bg-main: #f4fbf7;       /* \343\203\241\343\202\244\343\203\263\350\203\214\346\231\257\357\274\232\346\245\265\343\202\201\343\201\246\350\226\204\343\201\204\343\203\237\343\203\263\343\203\210\343\202\260\343\203\252\343\203\274\343\203\263 */\n  --bg-card: #ffffff;       /* \343\202\253\343\203\274\343\203\211\350\203\214\346\231\257\357\274\232\343\202\257\343\203\252\343\203\274\343\203\263\343\201\252\347\231\275 */\n  --text-main: #2b3a33;     /* \344\270\273\350\246\201\346\226\207\345\255\227\357\274\232\346\267\261\343\201\204\343\203\200\343\203\274\343\202\257\343\202\260\343\203\252\343\203\274\343\203\263 */\n  --text-sub: #5c6e65;      /* \350\243\234\345\212\251\346\226\207\345\255\227\357\274\232\343\203\236\343\202\244\343\203\253\343\203\211\343\201\252\343\202\260\343\203\254\343\203\274\343\202\260\343\203\252\343\203\274\343\203\263 */\n  --primary: #41b07d;       /* \343\203\227\343\203\251\343\202\244\343\203\236\343\203\252\357\274\232\345\204\252\343\201\227\343\201\204\346\226\260\347\267\221\343\201\256\343\202\260\343\203\252\343\203\274\343\203\263 */\n  --primary-hover: #359669; /* \343\203\227\343\203\251\343\202\244\343\203\236\343\203\252\343\203\233\343\203\220\343\203\274 */\n  --secondary: #e6f6ee;     /* \343\202\273\343\202\253\343\203\263\343\203\200\343\203\252\357\274\232\346\267\241\343\201\204\343\203\237\343\203\263\343\203\210 */\n  --secondary-text: #2f805a;\n  --accent-question: #ff8e53; /* \345\225\217\343\201\204\343\203\220\343\203\203\343\202\270\357\274\232\343\202\275\343\203\225\343\203\210\343\201\252\346\232\226\350\211\262\343\202\252\343\203\254\343\203\263\343\202\270 */\n  --accent-answer: #4a90e2;   /* \347\255\224\343\201\210\343\203\220\343\203\203\343\202\270\357\274\232\343\201\225\343\202\217\343\202\204\343\201\213\343\201\252\343\203\226\343\203\253\343\203\274 */\n  --shadow-soft: 0 16px 32px rgba(65, 176, 125, 0.08); /* \346\237\224\343\202\211\343\201\213\343\201\204\345\275\261 */\n  --shadow-hover: 0 24px 48px rgba(65, 176, 125, 0.15); /* \346\265\256\343\201\215\344\270\212\343\201\214\343\202\212\346\231\202\343\201\256\345\275\261 */\n  --font-family: \'Kosugi Maru\', \'Outfit\', sans-serif;\n  --border-radius-large: 28px;\n  --border-radius-medium: 16px;\n  --transition-smooth: all 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);\n}\n\n/* \345\237\272\346\234\254\343\203\252\343\202\273\343\203\203\343\203\210 & \343\202\277\343\202\244\343\203\235\343\202\260\343\203\251\343\203\225\343\202\243 */\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nbody {\n  font-family: var(--font-family);\n  background-color: var(--bg-main);\n  color: var(--text-main);\n  line-height: 1.8;\n  padding: 40px 20px;\n  -webkit-font-smoothing: antialiased;\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n}\n\n/* \343\203\230\343\203\203\343\203\200\343\203\274\343\203\207\343\202\266\343\202\244\343\203\263 */\n.main-header {\n  text-align: center;\n  margin-bottom: 30px;\n  max-width: 800px;\n  width: 100%;\n}\n\n.header-container {\n  background: var(--bg-card);\n  padding: 30px 40px;\n  border-radius: var(--border-radius-large);\n  box-shadow: var(--shadow-soft);\n  border: 2px solid rgba(65, 176, 125, 0.1);\n  position: relative;\n  overflow: hidden;\n}\n\n/* \350\243\205\351\243\276\347\232\204\343\201\252\350\203\214\346\231\257\343\202\260\343\203\251\343\203\207\343\203\274\343\202\267\343\203\247\343\203\263 */\n.header-container::before {\n  content: \'\';\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 6px;\n  background: linear-gradient(90deg, var(--primary), var(--accent-question), var(--accent-answer));\n}\n\n.badge {\n  display: inline-block;\n  background-color: var(--secondary);\n  color: var(--secondary-text);\n  font-size: 14px;\n  font-weight: bold;\n  padding: 6px 16px;\n  border-radius: 50px;\n  margin-bottom: 12px;\n}\n\nh1 {\n  font-size: 32px;\n  color: var(--text-main);\n  margin-bottom: 16px;\n  font-weight: 600;\n}\n\nruby rt {\n  font-size: 0.45em;\n  color: var(--text-sub);\n  letter-spacing: 0.1em;\n  padding-bottom: 2px;\n}\n\n.subtitle {\n  font-size: 18px;\n  color: var(--text-sub);\n  word-break: keep-all;\n}\n\n/* \343\202\253\343\203\206\343\202\264\343\203\252\343\203\212\343\203\223\343\202\262\343\203\274\343\202\267\343\203\247\343\203\263\343\202\277\343\203\226 */\n.category-nav {\n  margin-bottom: 40px;\n  width: 100%;\n  max-width: 900px;\n  display: flex;\n  justify-content: center;\n}\n\n.tabs-container {\n  display: flex;\n  gap: 16px;\n  background-color: #fff;\n  padding: 10px;\n  border-radius: 50px;\n  box-shadow: var(--shadow-soft);\n  border: 1px solid rgba(65, 176, 125, 0.08);\n  flex-wrap: wrap;\n  justify-content: center;\n}\n\n.tab-btn {\n  font-family: var(--font-family);\n  font-size: 18px;\n  font-weight: bold;\n  background: none;\n  border: none;\n  padding: 12px 28px;\n  border-radius: 40px;\n  cursor: pointer;\n  color: var(--text-sub);\n  transition: var(--transition-smooth);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n}\n\n.tab-btn:hover {\n  color: var(--text-main);\n  background-color: var(--bg-main);\n}\n\n.tab-btn.active {\n  background-color: var(--primary);\n  color: #fff;\n  box-shadow: 0 8px 20px rgba(65, 176, 125, 0.25);\n}\n\n/* \343\203\241\343\202\244\343\203\263\343\202\263\343\203\263\343\203\206\343\203\263\343\203\204 */\n.content-container {\n  max-width: 1200px;\n  width: 100%;\n  flex: 1;\n}\n\n/* \343\202\260\343\203\252\343\203\203\343\203\211\343\203\254\343\202\244\343\202\242\343\202\246\343\203\210 */\n.cards-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));\n  gap: 40px;\n  margin-bottom: 60px;\n  width: 100%;\n}\n\n/* \343\202\253\343\203\274\343\203\211\343\203\225\343\203\252\343\203\203\343\203\227\346\247\213\351\200\240 */\n.card-wrapper {\n  perspective: 1500px; /* 3D\345\212\271\346\236\234\343\201\256\345\245\245\350\241\214\343\201\215 */\n  animation: cardFadeIn 0.5s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;\n}\n\n/* \343\202\277\343\203\226\345\210\207\343\202\212\346\233\277\343\201\210\346\231\202\343\201\256\343\203\225\343\202\247\343\203\274\343\203\211\343\202\244\343\203\263\343\202\242\343\203\213\343\203\241\343\203\274\343\202\267\343\203\247\343\203\263 */\n@keyframes cardFadeIn {\n  from {\n    opacity: 0;\n    transform: scale(0.95) translateY(10px);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1) translateY(0);\n  }\n}\n\n.card-wrapper.hidden {\n  display: none !important;\n}\n\n.card-outer {\n  width: 100%;\n  height: 620px; /* \343\202\253\343\203\274\343\203\211\343\201\256\351\253\230\343\201\225\343\202\222\347\265\261\344\270\200 */\n  cursor: pointer;\n}\n\n.card-inner {\n  width: 100%;\n  height: 100%;\n  position: relative;\n  transform-style: preserve-3d;\n  transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n  box-shadow: var(--shadow-soft);\n  border-radius: var(--border-radius-large);\n}\n\n/* \343\203\233\343\203\220\343\203\274\343\201\212\343\202\210\343\201\263\343\203\225\343\202\251\343\203\274\343\202\253\343\202\271\345\212\271\346\236\234 */\n.card-outer:hover .card-inner {\n  box-shadow: var(--shadow-hover);\n  transform: translateY(-8px);\n}\n\n/* \343\203\225\343\203\252\343\203\203\343\203\227\347\212\266\346\205\213 */\n.card-wrapper.is-flipped .card-inner {\n  transform: rotateY(180deg);\n}\n\n/* \343\202\253\343\203\274\343\203\211\343\201\256\345\220\204\351\235\242\345\205\261\351\200\232\350\250\255\345\256\232 */\n.card-face {\n  position: absolute;\n  width: 100%;\n  height: 100%;\n  backface-visibility: hidden; /* \350\243\217\345\201\264\343\202\222\350\241\250\347\244\272\343\201\227\343\201\252\343\201\204 */\n  border-radius: var(--border-radius-large);\n  background-color: var(--bg-card);\n  border: 2px solid rgba(65, 176, 125, 0.08);\n  padding: 24px;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  overflow: hidden;\n}\n\n.card-back {\n  transform: rotateY(180deg); /* \345\210\235\346\234\237\347\212\266\346\205\213\343\201\247\350\243\217\350\277\224\343\201\227\343\201\246\343\201\212\343\201\217 */\n  border-color: rgba(74, 144, 226, 0.15);\n}\n\n/* \343\202\253\343\203\274\343\203\211\343\203\220\343\203\203\343\202\270\357\274\210\343\201\250\343\201\204 / \343\201\223\343\201\237\343\201\210\357\274\211 */\n.card-badge {\n  position: absolute;\n  top: 16px;\n  left: 16px;\n  font-size: 14px;\n  font-weight: bold;\n  color: #fff;\n  padding: 6px 14px;\n  border-radius: 50px;\n  box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);\n  z-index: 10;\n}\n\n.badge-question {\n  background-color: var(--accent-question);\n}\n\n.badge-answer {\n  background-color: var(--accent-answer);\n}\n\n/* \347\224\273\345\203\217\350\241\250\347\244\272\343\203\234\343\203\203\343\202\257\343\202\271 */\n.image-box {\n  width: 100%;\n  height: 280px;\n  border-radius: var(--border-radius-medium);\n  overflow: hidden;\n  position: relative;\n  background-color: #f7faf8;\n}\n\n.image-box img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.6s ease;\n}\n\n.card-outer:hover .image-box img {\n  transform: scale(1.04);\n}\n\n/* \343\203\206\343\202\255\343\202\271\343\203\210\343\203\234\343\203\203\343\202\257\343\202\271\357\274\210\343\203\253\343\203\223\344\273\230\343\201\215\346\226\207\345\255\227\347\224\250\357\274\211 */\n.text-box {\n  flex: 1;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 20px 10px;\n  text-align: left;\n}\n\n.question-text, .answer-text {\n  font-size: 20px;\n  color: var(--text-main);\n  word-break: keep-all;\n  font-weight: 500;\n  width: 100%;\n}\n\n/* \343\203\234\343\202\277\343\203\263\343\203\207\343\202\266\343\202\244\343\203\263 */\n.btn-group {\n  display: flex;\n  gap: 12px;\n}\n\n.btn {\n  font-family: var(--font-family);\n  font-size: 16px;\n  font-weight: bold;\n  border: none;\n  border-radius: var(--border-radius-medium);\n  padding: 14px 20px;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  transition: var(--transition-smooth);\n  flex: 1;\n  outline: none;\n}\n\n.btn-icon {\n  margin-right: 8px;\n  font-size: 18px;\n}\n\n/* \351\237\263\345\243\260\343\203\234\343\202\277\343\203\263\343\201\256\343\202\271\343\202\277\343\202\244\343\203\253\357\274\210\347\251\217\343\202\204\343\201\213\343\201\252\343\203\207\343\202\266\343\202\244\343\203\263\357\274\211 */\n.btn-audio {\n  background-color: #f0f3f1;\n  color: var(--text-sub);\n  border: 1px solid rgba(0, 0, 0, 0.05);\n}\n\n.btn-audio:hover {\n  background-color: #e2e7e4;\n  color: var(--text-main);\n}\n\n.btn-audio.is-playing {\n  background-color: #ffd8a8;\n  color: #d9480f;\n  animation: pulse 1.5s infinite;\n}\n\n/* \343\202\242\343\202\257\343\202\267\343\203\247\343\203\263\343\203\234\343\202\277\343\203\263\357\274\210\343\201\223\343\201\237\343\201\210\343\202\222\343\201\277\343\202\213 / \343\201\244\343\201\274\343\201\277\343\202\222\343\201\277\343\202\213\357\274\211 */\n.btn-action {\n  background-color: var(--primary);\n  color: #fff;\n  box-shadow: 0 6px 12px rgba(65, 176, 125, 0.2);\n}\n\n.btn-action:hover {\n  background-color: var(--primary-hover);\n  transform: translateY(-2px);\n  box-shadow: 0 8px 16px rgba(65, 176, 125, 0.3);\n}\n\n.btn-secondary {\n  background-color: var(--secondary);\n  color: var(--secondary-text);\n  box-shadow: none;\n}\n\n.btn-secondary:hover {\n  background-color: #d1ebd9;\n  transform: translateY(-2px);\n}\n\n.btn:active {\n  transform: scale(0.96) translateY(0);\n}\n\n.btn-arrow {\n  margin-left: 6px;\n  transition: transform 0.3s ease;\n}\n\n.btn-action:hover .btn-arrow {\n  transform: translateX(4px);\n}\n\n.btn-secondary:hover .btn-arrow {\n  transform: translateX(-4px);\n}\n\n/* \345\255\246\347\277\222\346\214\257\343\202\212\350\277\224\343\202\212\343\202\250\343\203\252\343\202\242 */\n.learning-note {\n  max-width: 900px;\n  margin: 0 auto 60px auto;\n  width: 100%;\n}\n\n.note-container {\n  background-color: #fffbeb; /* \346\232\226\343\201\213\343\201\204\343\202\244\343\202\250\343\203\255\343\203\274\343\201\214\343\201\213\343\201\243\343\201\237\347\231\275 */\n  padding: 35px;\n  border-radius: var(--border-radius-large);\n  box-shadow: 0 12px 28px rgba(245, 166, 35, 0.06);\n  border: 2px dashed rgba(245, 166, 35, 0.25);\n}\n\n.note-container h2 {\n  font-size: 22px;\n  color: #d97706;\n  margin-bottom: 16px;\n  display: flex;\n  align-items: center;\n}\n\n.note-container p {\n  font-size: 18px;\n  color: #78350f;\n  line-height: 1.9;\n}\n\n/* \343\203\225\343\203\203\343\202\277\343\203\274 */\n.main-footer {\n  text-align: center;\n  padding: 20px 0;\n  width: 100%;\n  border-top: 1px solid rgba(65, 176, 125, 0.1);\n}\n\n.main-footer p {\n  font-size: 14px;\n  color: var(--text-sub);\n}\n\n/* \351\237\263\345\243\260\345\206\215\347\224\237\346\231\202\343\201\256\343\203\221\343\203\253\343\202\271\343\202\242\343\203\213\343\203\241\343\203\274\343\202\267\343\203\247\343\203\263 */\n@keyframes pulse {\n  0% {\n    transform: scale(1);\n    box-shadow: 0 0 0 0 rgba(255, 142, 83, 0.4);\n  }\n  70% {\n    transform: scale(1.02);\n    box-shadow: 0 0 0 10px rgba(255, 142, 83, 0);\n  }\n  100% {\n    transform: scale(1);\n    box-shadow: 0 0 0 0 rgba(255, 142, 83, 0);\n  }\n}\n\n/* \343\203\254\343\202\271\343\203\235\343\203\263\343\202\267\343\203\226\350\252\277\346\225\264 */\n@media (max-width: 768px) {\n  body {\n    padding: 20px 10px;\n  }\n  \n  .header-container {\n    padding: 20px;\n  }\n  \n  h1 {\n    font-size: 26px;\n  }\n  \n  .subtitle {\n    font-size: 15px;\n  }\n  \n  .tabs-container {\n    padding: 6px;\n    border-radius: 20px;\n    gap: 8px;\n  }\n  \n  .tab-btn {\n    font-size: 15px;\n    padding: 8px 18px;\n  }\n  \n  .cards-grid {\n    grid-template-columns: 1fr;\n    gap: 30px;\n  }\n  \n  .card-outer {\n    height: 580px;\n  }\n  \n  .image-box {\n    height: 240px;\n  }\n  \n  .question-text, .answer-text {\n    font-size: 17px;\n  }\n  \n  .note-container {\n    padding: 20px;\n  }\n  \n  .note-container h2 {\n    font-size: 18px;\n  }\n  \n  .note-container p {\n    font-size: 15px;\n  }\n}\n"
        replacement_content: "@import \"tailwindcss\";\n\n@theme {\n  --color-brand-light: #f4fbf7;\n  --color-brand-primary: #41b07d;\n  --color-brand-hover: #359669;\n  --color-brand-secondary: #e6f6ee;\n  --color-brand-secondary-text: #2f805a;\n  --color-accent-question: #ff8e53;\n  --color-accent-answer: #4a90e2;\n}\n\n@layer utilities {\n  .perspective-1500 {\n    perspective: 1500px;\n  }\n  .preserve-3d {\n    transform-style: preserve-3d;\n  }\n  .backface-hidden {\n    backface-visibility: hidden;\n  }\n  .rotate-y-180 {\n    transform: rotateY(180deg);\n  }\n  .ruby-rt-small {\n    ruby rt {\n      font-size: 0.5em;\n      letter-spacing: 0.05em;\n      color: var(--color-gray-600);\n      padding-bottom: 2px;\n      font-weight: 500;\n    }\n  }\n}\n\n@keyframes cardFadeIn {\n  from {\n    opacity: 0;\n    transform: scale(0.95) translateY(10px);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1) translateY(0);\n  }\n}\n\n.animate-card-fade-in {\n  animation: cardFadeIn 0.5s cubic-bezier(0.25, 0.8, 0.25, 1) forwards;\n}\n\n@keyframes pulse-ring {\n  0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 142, 83, 0.4); }\n  70% { transform: scale(1.02); box-shadow: 0 0 0 10px rgba(255, 142, 83, 0); }\n  100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(255, 142, 83, 0); }\n}\n\n.animate-pulse-ring {\n  animation: pulse-ring 1.5s infinite;\n}"
      }
      num_matches: 1
    }
  }
}

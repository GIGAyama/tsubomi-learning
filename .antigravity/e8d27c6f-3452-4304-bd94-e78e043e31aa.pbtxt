201\266\343\202\223\343\201\250\343\200\201\343\200\214\343\201\223\343\201\237\343\201\210\343\200\215\343\201\256 \343\201\266\343\202\223\343\202\222 \343\202\210\343\201\217 \343\202\210\343\201\277\343\201\217\343\202\211\343\201\271\343\201\246 \343\201\277\343\202\210\343\201\206\343\200\202<br>\n          \343\201\244\343\201\274\343\201\277\343\201\256 <ruby>\345\275\242<rt>\343\201\213\343\201\237\343\201\241</rt></ruby>\343\202\204\343\200\201<ruby>\350\212\261<rt>\343\201\257\343\201\252</rt></ruby>\343\201\256 <ruby>\345\222\262<rt>\343\201\225</rt></ruby>\343\201\215\343\201\213\343\201\237\343\201\214\343\200\201\343\201\251\343\201\256\343\202\210\343\201\206\343\201\253 \343\201\233\343\201\244\343\202\201\343\201\204 \343\201\225\343\202\214\343\201\246\343\201\204\343\202\213\343\201\213\343\201\252\357\274\237<br>\n          <ruby>\346\225\231\347\247\221\346\233\270<rt>\343\201\215\343\202\207\343\201\206\343\201\213\343\201\227\343\202\207</rt></ruby>\343\201\256 \343\200\214\343\201\202\343\201\225\343\201\214\343\201\212\343\200\215\343\200\214\343\201\257\343\201\231\343\200\215\343\200\214\343\201\215\343\201\215\343\202\207\343\201\206\343\200\215\343\201\250 \343\201\212\343\201\252\343\201\230\343\202\210\343\201\206\343\201\253\343\200\201\343\201\257\343\201\230\343\202\201\343\201\253 \343\200\214\343\201\250\343\201\204\343\200\215\343\201\214\343\201\202\343\201\243\343\201\246\343\200\201\343\201\244\343\201\216\343\201\253 \343\200\214\343\201\223\343\201\237\343\201\210\343\200\215\343\201\214 \346\233\270\343\201\213\343\202\214\343\201\246\343\201\204\343\202\213 \343\201\230\343\202\205\343\202\223\343\201\230\343\202\207\343\202\222 \343\201\237\343\201\227\343\201\213\343\202\201\343\201\246 \343\201\277\343\202\210\343\201\206\343\200\202\n        </p>\n      </div>\n    </section>\n  </main>\n\n  <!-- \343\203\225\343\203\203\343\202\277\343\203\274 -->\n  <footer class=\"w-full text-center py-8 border-t border-brand-prima